{
    "name":  "mini_latex_editor",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "A local-first LaTeX workspace with a code editor and live PDF preview.",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Ali-Kazzazi/mini_LaTeX_Editor.git"
                   },
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "start":  "node server/index.mjs",
                    "dev":  "npm run build \u0026\u0026 node --watch server/index.mjs",
                    "test":  "node --test test/*.test.mjs",
                    "setup:compiler":  "node scripts/setup-compiler.mjs"
                },
    "engines":  {
                    "node":  "\u003e=22.13.0"
                },
    "dependencies":  {
                         "@codemirror/autocomplete":  "^6.18.0",
