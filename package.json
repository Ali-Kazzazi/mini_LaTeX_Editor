                         "@codemirror/language":  "^6.11.0",
                         "@codemirror/legacy-modes":  "^6.5.0",
                         "@codemirror/search":  "^6.5.0",
                         "@codemirror/state":  "^6.5.0",
                         "@codemirror/view":  "^6.36.0",
                         "express":  "^5.1.0",
                         "fflate":  "^0.8.2",
                         "pdfjs-dist":  "^6.4.299"
                     },
    "devDependencies":  {
                            "esbuild":  "^0.25.0"
                        }
}
